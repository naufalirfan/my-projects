# Shopee Flashsale Bot Config
# =============================
# Copy file ini ke .env dan isi data Anda
# JANGAN commit file .env ke git!

# ===== SHOPEE ACCOUNT =====
# Ambil dari browser DevTools > Application > Cookies > shopee.co.id
# Cookie yang wajib: SPC_EC, SPC_R_T_ID, SPC_U, SPC_F, csrftoken, SPC_SI, SPC_EC
SHOPEE_SPC_EC=
SHOPEE_SPC_R_T_ID=
SHOPEE_SPC_U=
SHOPEE_SPC_F=
SHOPEE_CSRFTOKEN=
SHOPEE_SPC_SI=

# Atau pakai SPC_EC saja (cookie utama), sisanya akan di-generate otomatis
# SHOPEE_SPC_EC=your_spc_ec_cookie_here

# CSRF Token (dapat dari header x-csrftoken atau cookie csrftoken)
# Bisa juga di-generate dari SPC_EC
SHOPEE_CSRF_TOKEN=

# User Agent (opsional, akan di-generate random jika kosong)
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ===== PRODUK TARGET =====
# Dapatkan dari URL produk: https://shopee.co.id/nama-produk-i.123456789.987654321
# shop_id = 123456789, item_id = 987654321
SHOP_ID=123456789
ITEM_ID=987654321

# Model ID (varian) - opsional, kosongkan jika produk tidak punya varian
# Dapat dari API item/detail atau inspeksi network saat pilih varian
MODEL_ID=0

# Jumlah yang dibeli (default 1 untuk flashsale)
QUANTITY=1

# Model ID 0 = produk tanpa varian / varian default
# Untuk dapatkan model_id: buka DevTools > Network > pilih varian > lihat request add_to_cart/checkout

# ===== FLASHSALE TIMING =====
# Format: HH:MM:SS (24 jam, timezone WIB/WIB+7)
# Contoh: 10:00:00 = jam 10 pagi WIB
FLASHSLE_TIME=10:00:00

# Timezone (default Asia/Jakarta = WIB)
TIMEZONE=Asia/Jakarta

# Waktu mulai cek sebelum flashsale (detik)
# Mulai request sebelum waktu flashsale untuk antisipasi delay jaringan
PRE_START_SECONDS=3

# Jumlah percobaan checkout per detik (rate limit aman ~5-10 req/detik)
ATTEMPTS_PER_SECOND=5

# Max percobaan total (0 = unlimited sampai beli berhasil / flashsale berakhir)
MAX_ATTEMPTS=0

# ===== CHECKOUT SETTINGS =====
# Gunakan COD (Cash on Delivery) = true/false
USE_COD=true

# Voucher/toko voucher ID (kosongkan jika tidak pakai voucher)
SHOP_VOUCHER_ID=
VOUCHER_CODE=

# Alamat pengiriman (address_id) - dapat dari API address/list
# Kosongkan = pakai alamat default
ADDRESS_ID=

# Catatan untuk penjual (opsional)
BUYER_NOTE=

# ===== ADVANCED SETTINGS =====
# Base URL Shopee (jangan diubah kecuali testing)
SHOPEE_API_URL=https://shopee.co.id/api/v4
SHOPEE_WEB_URL=https://shopee.co.id

# Timeout request (detik)
REQUEST_TIMEOUT=10

# Retry delay saat error (ms)
RETRY_DELAY_MS=100

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Simpan log ke file (true/false)
LOG_TO_FILE=true

# File log
LOG_FILE=logs/flashsale.log

# ===== PROXY (OPSIONAL) =====
# Format: http://user:pass@host:port
# HTTP_PROXY=
# HTTPS_PROXY=
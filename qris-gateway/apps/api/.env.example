# Database
# Production (PostgreSQL):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qris_gateway?schema=public"
# Dev localhost (SQLite, zero-install): uncomment below dan comment line PostgreSQL
# DATABASE_URL="file:./prisma/dev.db"

# Redis (optional - hanya untuk production queue/cache)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3000"

# InterActive QRIS API (from activation email)
INTERACTIVE_APIKEY=""
INTERACTIVE_MID=""
